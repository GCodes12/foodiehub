# ZAYORA production reverse proxy (compose.prod.yaml). Caddy obtains and renews the HTTPS certificate for
# PUBLIC_HOSTNAME automatically (Let's Encrypt; ports 80 and 443 must be reachable) and redirects HTTP to HTTPS.
# It sets X-Forwarded-For/-Proto/-Host for Keycloak and the web app's nginx.

{$PUBLIC_HOSTNAME} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	redir /auth /auth/ 308

	# Keycloak at /auth. Its admin console, admin REST API and the master realm are never public: use an SSH tunnel to
	# the server's 127.0.0.1:8080 instead (the services reach the admin API inside the Docker network).
	handle /auth/* {
		@private path /auth/admin /auth/admin/* /auth/realms/master /auth/realms/master/*
		respond @private 404
		reverse_proxy keycloak:8080
	}

	# Everything else: the web app (nginx), which forwards /api/** to the API gateway.
	handle {
		reverse_proxy frontend:8080
	}
}
