# ZAYORA production settings: template for the server's own .env (compose.prod.yaml). Copy it to .env ON THE SERVER only,
# fill in every value, then `chmod 600 .env`. Never commit the filled-in file, and never reuse local development values
# or demo accounts here.
#
# Generate each secret separately, e.g.  openssl rand -hex 32   (hex: no quotes or other characters that need escaping).

# Public host name with a DNS A record pointing at the server (no scheme, no path). Caddy gets its HTTPS certificate for it.
PUBLIC_HOSTNAME=CHANGE_ME.example

# --- MySQL (stack database, never published) ---
MYSQL_ROOT_PASSWORD=CHANGE_ME
RESTAURANT_DB_MIGRATOR_PASSWORD=CHANGE_ME
RESTAURANT_DB_APP_PASSWORD=CHANGE_ME
ORDER_DB_MIGRATOR_PASSWORD=CHANGE_ME
ORDER_DB_APP_PASSWORD=CHANGE_ME
# Keycloak's own database account (keycloak_db), created on the first start.
KEYCLOAK_DB_PASSWORD=CHANGE_ME

# --- Keycloak ---
# Temporary master-realm admin, created on the very first start only. Create a permanent admin in the admin console,
# then delete this temporary account there (see the deployment steps).
KEYCLOAK_ADMIN_USER=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# Secret of the read-only directory client foodiehub-admin-api (at least 24 characters). Written into Keycloak by the
# realm import and read by restaurant-service.
KEYCLOAK_ADMIN_API_CLIENT_SECRET=CHANGE_ME
# Owner account creation (DEC-018) stays disabled in production until its Keycloak permissions are set up by hand.
# Leave empty.
KEYCLOAK_OWNER_PROVISIONER_CLIENT_SECRET=
