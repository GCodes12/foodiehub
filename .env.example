# FoodieHub local configuration template.
# Copy to .env (git-ignored) and replace every CHANGE_ME value. Never commit .env.
# Format: KEY=value, one per line, no quotes. Do not use quotes, backslashes, "$" or spaces in values
# (.env is read by Spring Boot, by infra/mysql/local/setup-local-db.sh and by Docker Compose).
# Real environment variables (e.g. set in an IntelliJ run configuration) override these values.

# --- MySQL server location (local MySQL or Docker; both default to localhost:3306) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
# Optional: full JDBC URL. If unset, jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/restaurant_db is used.
# RESTAURANT_DB_URL=jdbc:mysql://localhost:3306/restaurant_db

# --- restaurant-service database accounts ---
# Recommended: dedicated accounts (infra/mysql/local/setup-local-db.sh creates them).
# Quick local alternative: set both *_USER values to your local admin account (e.g. root) and its password.
# Flyway migration user (DDL + dev seed data on restaurant_db only).
RESTAURANT_DB_MIGRATOR_USER=restaurant_migrator
RESTAURANT_DB_MIGRATOR_PASSWORD=CHANGE_ME_migrator_password
# Runtime application user (SELECT only on restaurant_db).
RESTAURANT_DB_APP_USER=restaurant_app
RESTAURANT_DB_APP_PASSWORD=CHANGE_ME_app_password

# --- order-service database accounts (same pattern as above) ---
# ORDER_DB_URL=jdbc:mysql://localhost:3306/order_db
ORDER_DB_MIGRATOR_USER=order_migrator
ORDER_DB_MIGRATOR_PASSWORD=CHANGE_ME_order_migrator_password
ORDER_DB_APP_USER=order_app
ORDER_DB_APP_PASSWORD=CHANGE_ME_order_app_password

# --- Keycloak (local install; see README) ---
KEYCLOAK_HOME=/Users/<you>/dev-tools/keycloak-26.8.1
KEYCLOAK_PORT=8080
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/foodiehub
# Master-realm admin, created on Keycloak's first start only.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin_password
# Password for the local demo users alice and bob.
FOODIEHUB_DEMO_USER_PASSWORD=CHANGE_ME_demo_user_password

# --- Optional Docker setup only (compose.yaml); not used with a locally installed MySQL ---
MYSQL_ROOT_PASSWORD=CHANGE_ME_docker_root_password
