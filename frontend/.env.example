# Frontend settings (all optional; the defaults below match the local setup). Copy to .env.local to change them.
# Only VITE_* variables reach the browser, so never put secrets here — the Keycloak client is public (PKCE).

# Service base URLs. Empty = same origin: the Vite dev proxy forwards /api/v1/restaurants → :8081 and
# /api/v1/orders → :8082 (vite.config.ts). Direct URLs (http://localhost:8081) also need CORS on the services.
VITE_RESTAURANT_API_URL=
VITE_ORDER_API_URL=

# Restaurant to show. Empty = the first active restaurant listed by the Restaurant Service.
VITE_RESTAURANT_ID=

VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=foodiehub
VITE_KEYCLOAK_CLIENT_ID=foodiehub-frontend
