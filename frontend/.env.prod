# Production web build: PUBLIC_HOSTNAME=your.domain npm run build:prod  (Vite mode "prod"; see compose.prod.yaml).
# Committed on purpose: these are public browser settings, never secrets (the Keycloak client is public, PKCE).
# A custom mode instead of .env.production, so the normal `npm run build` for the local stack stays unchanged.
# PUBLIC_HOSTNAME is read from the build's shell environment. Values here override .env and .env.local.

# Empty: the app calls /api/** on its own origin; nginx forwards it to the API gateway.
VITE_RESTAURANT_API_URL=
VITE_ORDER_API_URL=
# Empty: ZAYORA's id from the app's default.
VITE_RESTAURANT_ID=
# Keycloak behind Caddy on the same origin.
VITE_KEYCLOAK_URL=https://${PUBLIC_HOSTNAME}/auth
VITE_KEYCLOAK_REALM=foodiehub
VITE_KEYCLOAK_CLIENT_ID=foodiehub-frontend
